-- 1. ยิงไกลขึ้น (Extended Bullet Range / Hitbox Multiplier)
local rangeActive = false
local rangeLoop
createBtn(MainContainer, "🔫 ยิงไกลขึ้น (Extended Range)", function(state)
    rangeActive = state
    if state then
        rangeLoop = RunService.RenderStepped:Connect(function()
            pcall(function()
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                        p.Character.Head.Size = Vector3.new(3, 3, 3)
                        p.Character.Head.Transparency = 0.5
                        p.Character.Head.CanCollide = false
                    end
                end
            end)
        end)
    else
        if rangeLoop then rangeLoop:Disconnect() end
        for _, p in pairs(Players:GetPlayers()) do
            pcall(function()
                if p.Character and p.Character:FindFirstChild("Head") then
                    p.Character.Head.Size = Vector3.new(1.2, 1.2, 1.2)
                    p.Character.Head.Transparency = 0
                end
            end)
        end
    end
end)

-- 2. วิ่งเร็ว (ปรับได้ 1-500)
local runSpeed = 60
local speedActive = false

createSlider(MainContainer, "⚡ ความเร็วการวิ่ง", 1, 500, 60, function(v) runSpeed = v end)

createBtn(MainContainer, "⚡ เปิด/ปิด วิ่งเร็ว (Speed)", function(state)
    speedActive = state
    task.spawn(function()
        while speedActive do
            RunService.RenderStepped:Wait()
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                    if char.Humanoid.MoveDirection.Magnitude > 0 then
                        char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + (char.Humanoid.MoveDirection * (runSpeed / 45))
                    end
                end
            end)
        end
    end)
end)

